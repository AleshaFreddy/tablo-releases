# Токен от @BotFather. Никогда не коммитьте настоящий токен в репозиторий!
BOT_TOKEN=123456:ABC-replace-me

# ID канала (-100...) или @username публичного канала.
# Можно оставить пустым: бот запомнит канал сам, когда его сделают админом,
# или когда вы перешлёте ему любой пост из канала.
CHANNEL_ID=

# Часовой пояс, в котором вводятся и показываются дедлайны.
TZ_NAME=Europe/Moscow

# Кто может добавлять дедлайны: Telegram ID через запятую.
# Пусто - все подписчики канала.
ALLOWED_USER_IDS=

# Где хранить базу.
DB_PATH=deadlines.db

# Google-таблица с мероприятиями (ссылка на нужный лист, с #gid=...).
# Таблица должна открываться по ссылке без входа (доступ «читатель» для всех, у кого есть ссылка)
# или быть опубликована в CSV: Файл - Поделиться - Опубликовать в интернете.
SHEET_URL=https://docs.google.com/spreadsheets/d/1VQZ0sGJBmXm9qtyRnn53EVzNqurqxQ9GBjcLNt5_gcU/edit#gid=1321490059
# Как часто перечитывать таблицу, минут.
SHEET_SYNC_MINUTES=10
# Писать в канал о новых и перенесённых дедлайнах из таблицы (1/0).
SHEET_ANNOUNCE_CHANGES=1

# Категории дедлайнов по умолчанию (через запятую). Потом список меняется командами /categories и /addcategory.
CATEGORIES=Внеучебка,РАНХиГС,Магистратура

# Люди группы: имя, как оно записано в таблице в «Ответственных», = ник в Telegram.
# По этому списку бот упоминает людей в канале и показывает их в /new.
TEAM=Айсаар=@aisbaiss,Настя=@vfthjdf,Оля=@devinaolga,Сеня=@arssi52,Лёша=@AlexeyCheshko
